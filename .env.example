# Nodulz self-host configuration
# Docker: save as .env beside docker-compose.yaml.
# Fill version, public URL, administrator details and both application secrets.
# Full reference: https://nodulz.com/docs/self-host-configuration
# Commented settings are optional. Uncomment only what you need to override.
# Explicit system settings lock their corresponding administration fields.

NODULZ_VERSION=0.29.9
NODULZ_PUBLIC_URL=http://localhost:3001

ADMIN_USERNAME=admin
ADMIN_NAME=Admin
ADMIN_EMAIL=
# Required for a new instance. Set a unique password of 8-128 characters.
# Blank values and the old example password are rejected.
ADMIN_PASSWORD=''
WORKSPACE_NAME=nodulz
WORKSPACE_SLUG=nodulz

# Required for all database engines. Run openssl rand -hex 32 twice;
# paste a different result for each key. Keep these keys across restarts/upgrades.
BETTER_AUTH_SECRET=
CREDENTIALS_ENCRYPTION_KEY=

# Passwords: use single quotes in Compose .env files to preserve literal $.
# Kubernetes --from-env-file uses literal values: remove surrounding quotes.
# PostgreSQL with Compose: uncomment POSTGRES_PASSWORD below and generate
# a third independent value with openssl rand -hex 32 (safe in DATABASE_URL).
# MySQL or MariaDB with Compose: generate MYSQL_PASSWORD the same way.
# Kubernetes with an external database: set DATABASE_URL in the instance Secret.

# Deployment and URLs
# NODULZ_PORT=3001
# NODULZ_DOMAIN=nodulz.example.com
# BETTER_AUTH_URL=http://localhost:3001
# CLIENT_ORIGIN=http://localhost:3001
# WEBHOOK_BASE_URL=http://localhost:3001
# NODULZ_PUBLIC_API_URL=http://localhost:3001
# TRUSTED_PROXIES=127.0.0.1,::1

# Database, secrets and files
# DATABASE_DRIVER=sqlite
# DATABASE_PATH=/app/data/nodulz.db
# DATABASE_URL=postgresql://nodulz:PASSWORD@postgres.example.com:5432/nodulz
# POSTGRES_PASSWORD=
# MYSQL_PASSWORD=
# DATABASE_URL=mysql://nodulz:PASSWORD@db.example.com:3306/nodulz?ssl-mode=VERIFY_IDENTITY
# NODULZ_DATA_ROOT=/app/data
# HOST_FILES_ROOT=/app/data/host-files
# NODULZ_IAC_DATA_ROOT=/app/data/iac-states
# HOST_FILES_MAX_BYTES=52428800
# EXTERNAL_SECRETS_PRIVATE_HOSTS=bao.internal.example,bw-gateway.internal.example

# Authentication and Microsoft connections
# AUTH_PASSWORD_ENABLED=true
# AUTH_PROVIDERS=[]
# AUTH_SETTINGS_USE_ENV=false
# BETTER_AUTH_API_KEY=
# BETTER_AUTH_SENTINEL_IDENTIFY_URL=
# MICROSOFT_GRAPH_CLIENT_ID=
# MICROSOFT_GRAPH_CLIENT_SECRET=
# MICROSOFT_GRAPH_TENANT=common

# Email
# SMTP_HOST=smtp.example.com
# MAIL_FROM=nodulz@example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Execution and history
# WORKFLOW_RUN_TIMEOUT_MS=60000
# WORKFLOW_TOTAL_TIMEOUT_MS=3600000
# WORKFLOW_TOTAL_TIMEOUT_MAX_MS=604800000
# WORKFLOW_MAX_ACTIVE=4
# WORKFLOW_MAX_PENDING=32
# HTTP_RESPONSE_MAX_BYTES=52428800
# HTTP_PRIVATE_HOSTS=api.internal.example,10.0.0.10
# HISTORY_COMPACT_WRITES=false
# HISTORY_PURGE_ENABLED=false

# Scripts and Kubernetes
# Compose Docker overlay only: host data path and Docker socket group ID.
# NODULZ_HOST_DATA_ROOT=/srv/nodulz/data
# DOCKER_GID=999
# CONTAINER_ENGINE=docker
# SCRIPT_RUNTIME=auto
# SCRIPT_MEMORY_MIB=2048
# SCRIPT_CPUS=2
# SCRIPT_PIDS_LIMIT=256
# SCRIPT_LOG_MAX_BYTES=536870912
# SCRIPT_HOST_CPUS=0
# SCRIPT_HOST_MEMORY_MIB=0
# SCRIPT_CACHE_ENABLED=true
# KUBERNETES_NAMESPACE=nodulz
# NODULZ_DATA_PVC=nodulz-data
# KUBERNETES_NODE_NAME=
# KUBERNETES_DATA_PVC_SHARED=false
# SCRIPT_JOB_IMAGE_PULL_SECRETS=
# SCRIPT_JOB_STARTUP_TIMEOUT_MS=180000
# SCRIPT_JOB_TTL_SECONDS=600
# SCRIPT_WARM_POOL_SIZE=1
# SCRIPT_WARM_POOL_MAX_IDLE=4
# SCRIPT_WARM_POOL_IDLE_MS=120000

# Media and Python
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# DEMUCS_PATH=demucs
# MEDIA_MAX_BYTES=52428800
# MEDIA_PROCESS_TIMEOUT_MS=120000
# CLOUD_PYTHON_BIN=python3

# Metrics
# METRICS_PROMETHEUS_ENABLED=false
# METRICS_PUBLIC=false
# METRICS_TOKEN=
# METRICS_INSTANCE_ID=nodulz
# METRICS_OTLP_ENABLED=false
# METRICS_OTLP_ENDPOINT=http://otel-collector:4318/v1/metrics
# METRICS_OTLP_HEADERS={}
# METRICS_EXPORT_INTERVAL_MS=30000
# METRICS_MAX_SERIES=10000
# METRICS_MAX_SERIES_PER_DECLARATION=100

# Log streaming
# LOG_STREAM_PROVIDER=otlp
# LOG_STREAM_ENDPOINT=https://collector.example/v1/logs
# LOG_STREAM_HEADERS={}
# LOG_STREAM_WORKFLOW_ENABLED=false
# LOG_STREAM_SERVER_ENABLED=false
# LOG_STREAM_AUDIT_ENABLED=false

# Build-time frontend variables
# These do not change a prebuilt image; use the runtime Sentinel settings above.
# VITE_BETTER_AUTH_SENTINEL_ENABLED=true
# VITE_BETTER_AUTH_SENTINEL_IDENTIFY_URL=https://kv.better-auth.com/projects/<project-id>
